{
  "manifest_version": 3,
  "name": "Tabloom",
  "version": "1.4.0",
  "minimum_chrome_version": "111",
  "homepage_url": "https://tabloom.1619.in/",
  "description": "Your new tab, in bloom: work calendar, sticky notes, tasks, bookmarks and every tool you use.",
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "permissions": ["storage", "unlimitedStorage", "favicon", "bookmarks", "activeTab", "contextMenus"],
  "optional_permissions": ["history"],
  "host_permissions": ["https://www.google.com/s2/favicons*", "https://*.gstatic.com/*", "https://calendar.google.com/*"],
  "background": { "service_worker": "src/sw.js", "type": "module" },
  "action": {
    "default_title": "Save this page to Tabloom",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save this page to Tabloom"
    }
  },
  "icons": {
    "16": "assets/logo/16.png",
    "32": "assets/logo/32.png",
    "48": "assets/logo/48.png",
    "128": "assets/logo/128.png"
  }
}
